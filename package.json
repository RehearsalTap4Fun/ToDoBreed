{
  "name": "gsi-incubator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "collect": "node scripts/collect-todos.mjs",
    "release": "npm run build && mkdir -p release && cp dist/index.html \"release/怪奇生物孵化器.html\" && cp public/gsi-inbox.js release/gsi-inbox.js 2>/dev/null; echo \"单机版: release/怪奇生物孵化器.html\"",
    "sync:qmonster": "node scripts/sync-qmonster.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "~4.4.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.6",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.1"
  }
}
